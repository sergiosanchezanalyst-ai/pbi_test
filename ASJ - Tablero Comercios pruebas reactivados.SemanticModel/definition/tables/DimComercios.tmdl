	column 'Datos Completos' =
			
			"FECHA ALTA: "&
			FORMAT(DimComercios[FechaAlta1],"YYYY")&
			"-"&
			FORMAT(DimComercios[FechaAlta1],"MM")&
			"-"&
			FORMAT(DimComercios[FechaAlta1],"DD")&
			" / "&
			"COMERCIO: " &
			DimComercios[Comercio]&
			" / "&
			"NÚMERO ENTE: "&
			DimComercios[NumeroEnte]&
			" / "&
			"CUIT: "&
			DimComercios[CUIT]&
			" / "
			&"RUBRO: "&
			DimComercios[RubroComercio]
			
			/*"FECHA ALTA: "&
			DimComercios[FechaAlta1]&
			" / "&
			"COMERCIO: " &
			DimComercios[Comercio]&
			" / "&
			"NÚMERO ENTE: "&
			DimComercios[NumeroEnte]&
			" / "&
			"CUIT: "&
			DimComercios[CUIT]&
			" / "
			&"RUBRO: "&
			DimComercios[RubroComercio]
			*/
		lineageTag: 6fd99e20-0ec9-4aab-a550-e645818f1c1c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Datos Completos 1' = ```
			
			"COMERCIO: " &
			DimComercios[Comercio]&
			" / "&
			"NÚMERO ENTE: "&
			DimComercios[NumeroEnte]&
			" / "&
			"CUIT: "&
			DimComercios[CUIT]&
			" / "
			&"RUBRO: "&
			DimComercios[RubroComercio]
			
			/*
			&
			" / "
			&"PROVINCIA: "&
			DimComercios[Provincia]
			*/
			
			&
			" / "
			&"FECHA ALTA: "&
			DimComercios[FechaAlta]
			
			```
		lineageTag: c8b63ffb-ea5f-442c-992a-a3b106411867
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

