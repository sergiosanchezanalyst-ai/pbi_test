			    'DimComercios'[Entidad],
			    "Provincia de Santa Fe", "Santa Fe",
			    "Provincia de Entre Ríos", "Entre Ríos",
			    "Provincia de San Juan", "San Juan",
			    "Provincia de Santa Cruz", "Santa Cruz",
			    BLANK()
			)
