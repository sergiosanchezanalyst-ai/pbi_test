	measure 'Comercios Trx' = sum(FactTransaccionesComercios[CantidadTxt])
		displayFolder: Comercios
		lineageTag: bfac2361-a7af-4c98-b7df-309ba1f2157a

		formatStringDefinition = ```
				VAR Valor = SELECTEDMEASURE()
				VAR Escala = DIVIDE(Valor, 1000) 
				-- Verificamos si al dividir por 1000 nos da exacto (sin residuo decimal)
				VAR EsRedondo = MOD(Escala, 1) = 0 
				
				RETURN
				SWITCH(
				    TRUE(),
				    
				    -- Si es menor a 1000, mostramos número entero normal sin K
				    ABS(Valor) < 1000, "# ##0",
				    
				    -- Si es mayor a 1000 Y es redondo (Ej: 2000), usamos una coma para escalar pero SIN .0
				    EsRedondo, "# ##0, ""K""",
				    
				    -- Si es mayor a 1000 Y tiene decimales (Ej: 2500), usamos una coma para escalar Y el .0
				    "# ##0,.0 ""K"""
				)
				```

	measure 'Comercios Trx mes ant' =
			
			CALCULATE(
			    [TRX SIN FORMATO],
			    DATEADD('DimTiempo'[Fecha], -1, MONTH)
			)
		formatString: #,0
		displayFolder: Comercios
		lineageTag: ee7283f6-978f-4f68-92fd-eba7c0318436

	measure 'Comercios Ticket Promedio' =
			
			DIVIDE (
			[Comercios Monto Bruto],
			[Comercios Trx],
			    0
			)
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: Comercios
		lineageTag: d0644a9f-7430-4bc9-98d9-ea26c078e6c7

