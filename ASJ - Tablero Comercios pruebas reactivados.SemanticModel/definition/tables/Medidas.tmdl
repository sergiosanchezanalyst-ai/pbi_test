	measure 'Cantidad Comercios nuevos %MoM label' =
			
			VAR Variacion = [Cantidad Comercios nuevos %MoM]
			VAR Flecha =
			    IF(
			        Variacion > 0,
			        "▲",
			        IF(Variacion < 0, "▼", "•")
			    )
			VAR Porcentaje =
			    FORMAT(ABS(Variacion), "0.0%")
			RETURN
			Flecha & " " & Porcentaje
		displayFolder: Comercios - Label & Color
		lineageTag: b523a058-3dbe-41cc-b5eb-76b73cae719e

	measure 'Cantidad Comercios nuevos %MoM color' =
			
			SWITCH(
			    TRUE(),
			[Cantidad Comercios nuevos %MoM] > 0, "#00B050",   -- Verde
			    [Cantidad Comercios nuevos %MoM] < 0, "#FF0000",   -- Rojo
			    "#808080"                         -- Gris neutro si es 0 o sin valor
			)
		displayFolder: Comercios - Label & Color
		lineageTag: ddf0ed10-ff27-48f2-ad75-b2bd0e2a9fa8

