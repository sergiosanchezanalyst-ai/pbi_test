	measure 'Comercios Monto Bruto formateado' = ```
			
			
			VAR Valor = [Comercios Monto Bruto]  -- tu medida base
			RETURN
			SWITCH(
			    TRUE(),
			    ABS(Valor) >= 1000000000, FORMAT(Valor / 1000000000, "$# ##0.00") & " MM",
			    ABS(Valor) >= 1000000,    FORMAT(Valor / 1000000, "$# ##0.00") & " M",
			    FORMAT(Valor, "$# ##0")
			)
			
			```
		displayFolder: Formato MM - K
		lineageTag: 45a14888-6a17-4c55-8b48-4b024918ee92

	measure 'Comercios Ticket Promedio formateado' = ```
			
			
			VAR Valor = [Comercios Ticket Promedio]  -- reemplazá por tu medida base
			VAR Escala =
			    SWITCH(
			        TRUE(),
			        ABS(Valor) >= 1000, Valor / 1000,
			        Valor
			    )
			VAR Sufijo =
			    SWITCH(
			        TRUE(),
			        ABS(Valor) >= 1000, " K",
			        ""
			    )
			RETURN
			IF(
			    MOD(Escala,1) = 0,
			    FORMAT(Escala, "$# ##0") & Sufijo,
			    FORMAT(Escala, "$# ##0.0") & Sufijo
			)
			
			```
		displayFolder: Formato MM - K
		lineageTag: f964f1bb-0c14-4369-96f6-abd6f2c1e1fb

