	measure 'Comercios Reactivados 1 (Acum.)' = ```
			
			VAR FechaMaxEjeX = MAX('DimTiempo (2)'[Fecha])
			VAR MinFechaSelector = MIN('DimTiempo'[Fecha])
			VAR MaxFechaSelector = MAX('DimTiempo'[Fecha])
			
			// 1. Calculamos el acumulado real sin que el selector principal corte el pasado
			VAR ResultadoAcumulado = 
			    CALCULATE(
			        [Comercios Reactivados 1],
			        FILTER(
			            ALL('DimTiempo (2)'),
			            'DimTiempo (2)'[Fecha] <= FechaMaxEjeX && 
			            'DimTiempo (2)'[Fecha] >= DATE(2025, 1, 1)
			        ),
			        REMOVEFILTERS('DimTiempo')
			    )
			
			// 2. Forzamos a que el gráfico solo muestre las barras/puntos del periodo seleccionado
			RETURN
			IF(
			    FechaMaxEjeX >= MinFechaSelector && FechaMaxEjeX <= MaxFechaSelector,
			    ResultadoAcumulado
			)
			```
		formatString: 0
		lineageTag: 831c30df-495e-4995-8029-c624c0557e29

