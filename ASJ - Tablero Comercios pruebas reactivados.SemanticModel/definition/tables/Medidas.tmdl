			))
		lineageTag: 90b86f2e-755d-4896-b5c8-3a0f12ad9e92

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TRX SIN FORMATO Comercios Nuevos 2027' = SUM(Comercios_nuevos_2027[trx])
		formatString: 0
		lineageTag: 1cebfbd5-4973-4787-a70b-5f0e9fe4c1bc

	measure 'Monto Comercios nuevos 2027' = sum(Comercios_nuevos_2027[monto_bruto])
		lineageTag: 5b91238f-41d8-4435-bb69-e41148419c93

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ticket Promedio Comercios nuevos 2027' =
			
			DIVIDE (
			[Monto Comercios nuevos 2027],
			[TRX SIN FORMATO Comercios Nuevos 2027],
			    0)
		formatString: #,0
		lineageTag: ec0296a3-a264-4a9c-84c9-d5872c276529

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Comercios nuevos sin transacciones FY 2027' =
			
			IF(
			    SELECTEDVALUE('DimTiempo (2)'[AñoFiscal]) = 2027,
			    CALCULATE([Cantidad Comercios nuevos]) - DISTINCTCOUNT(Comercios_nuevos_2027[ComercioEcosistemaID]),
			    0
			)
		formatString: 0
		lineageTag: b1c30b95-3b7c-4b49-90ff-d5530af14934

	measure 'TRX REALIZADAS' = CALCULATE(sum(FactTransaccionesComercios[CantidadTxt]),FactTransaccionesComercios[EstadoTransaccionID] = 11)
		formatString: 0
		lineageTag: c22cbef4-1406-49b0-b0dc-bb5948b82f90

	measure 'MONTO BRUTO REALIZADAS' = CALCULATE(sum(FactTransaccionesComercios[MontoBruto]),FactTransaccionesComercios[EstadoTransaccionID] = 11)
		lineageTag: 5aa2ef84-7587-4c19-97d9-ad214931f120

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ticket Promedio REALIZADAS' =
			
			DIVIDE (
			[MONTO BRUTO REALIZADAS],
			[TRX REALIZADAS],
			    0
			)
		lineageTag: a02d4dd8-2e78-450f-876e-c7630a7686b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cantidad comercios nuevos detalle' =
			
			CALCULATE(
			    DISTINCTCOUNT(Comercios_nuevos_2027[ComercioEcosistemaID]),
			    OR(
			        Comercios_nuevos_2027[flag_comercio_reactivado_2026] = "Comercio Nuevo",
			        Comercios_nuevos_2027[flag_comercio_reactivado_2027] = "Comercio Nuevo"
			    )
			)
		formatString: 0
		lineageTag: ca050a13-f75b-405e-8894-37ac92b5199b

	measure 'Comercios Nuevos sin Trx nuevo' =
			
			CALCULATE(
			    [Cantidad comercios nuevos detalle] ,
			    FILTER(
			        VALUES(Comercios_nuevos_2027[ComercioEcosistemaID]) , // Reemplazar por tu tabla y columna de clave única de comercio
			        ISBLANK([TRX REALIZADAS]) || [TRX REALIZADAS] = 0
			    )
			)
		formatString: 0
		lineageTag: 1d034400-c3a9-4ce6-abf2-422f36d06161

	measure 'TRX Comercios Reactivados' =
			
			CALCULATE(
			    SUM('FactTransaccionesComercios'[CantidadTxt]),
			    CROSSFILTER('ComerciosReactivados_Long'[ComercioEcosistemaID], 'DimComercioEcosistemaID_Unicos'[ComercioEcosistemaID], BOTH)
			)
		formatString: 0
		lineageTag: 654fb9f6-a431-47e6-aec5-ddcda4f365db

