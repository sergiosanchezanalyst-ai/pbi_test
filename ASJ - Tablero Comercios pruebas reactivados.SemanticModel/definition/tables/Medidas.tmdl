	measure Filtro_Mapa =
			
			VAR _Transacciones = [TRX SIN FORMATO]
			VAR _MinSeleccionado = MIN(Rango_Trx[Min])
			VAR _MaxSeleccionado = MAX(Rango_Trx[Max])
			
			RETURN
			IF(
			    ISFILTERED(Rango_Trx[Etiqueta (Texto)]),
			    IF(_Transacciones >= _MinSeleccionado && _Transacciones <= _MaxSeleccionado, 1, 0),
