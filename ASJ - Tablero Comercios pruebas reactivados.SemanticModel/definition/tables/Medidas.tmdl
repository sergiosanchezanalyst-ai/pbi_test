	measure 'Comercios Reactivados total (Acum.)' = ```
			
			VAR AnioSeleccionado = SELECTEDVALUE('DimTiempo'[AñoFiscal])
			VAR FechaMaxEjeX = MAX('DimTiempo (2)'[Fecha])
			VAR MinFechaSelector = MIN('DimTiempo'[Fecha])
			VAR MaxFechaSelector = MAX('DimTiempo'[Fecha])
			
			VAR Resultado2026 = 
			    CALCULATE(
			        [Comercios Reactivados 1],
			        FILTER(
			            ALL('DimTiempo (2)'),
			            'DimTiempo (2)'[Fecha] <= FechaMaxEjeX && 
			            'DimTiempo (2)'[Fecha] >= DATE(2025, 1, 1)
			        ),
			        REMOVEFILTERS('DimTiempo')
			    )
			
			VAR Resultado2027 = 
			    CALCULATE(
			        [Comercios Reactivados 2027],
			        FILTER(
			            ALL('DimTiempo (2)'),
			            'DimTiempo (2)'[Fecha] <= FechaMaxEjeX && 
			            'DimTiempo (2)'[Fecha] >= DATE(2025, 1, 1)
			        ),
			        REMOVEFILTERS('DimTiempo')
			    )
			
			VAR ResultadoFinal = 
			    SWITCH(
			        TRUE(),
			        AnioSeleccionado = 2026, Resultado2026,
			        AnioSeleccionado = 2027, Resultado2027,
			        ISBLANK(AnioSeleccionado), Resultado2026 + Resultado2027,
			        BLANK()
			    )
			
			RETURN
			IF(
			    FechaMaxEjeX >= MinFechaSelector && FechaMaxEjeX <= MaxFechaSelector,
			    ResultadoFinal
			)
