	measure 'Comercios % Part Clientes' = ```
			
			VAR ClientesComercio = [Comercios Cantidad Clientes]
			VAR ClientesTotales = 
			    CALCULATE (
			       [Comercios Cantidad Clientes],
			        ALL ( DimComercios_Unicos ) -- Quita el filtro de comercio para obtener el universo total
			    )
			RETURN
