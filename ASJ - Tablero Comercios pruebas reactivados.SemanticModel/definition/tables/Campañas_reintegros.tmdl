table Campañas_reintegros
	lineageTag: 7dca921f-1414-4141-86bb-b3d72febc4d0

	measure '% Monto por campaña' = ```
			
			var actual = [MONTO BRUTO SIN FORMATO]
			var total = CALCULATE([MONTO BRUTO SIN FORMATO],'DimCampañas'[Campaña_Grupo] IN 
			{ "Campañas con Cuotas", "Campañas con Reintegro","Sin Campañas" })
			RETURN
			
			actual/total
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
