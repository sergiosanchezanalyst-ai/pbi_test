	column Provincia =
			
			VAR NombreEntidad = 'Operaciones DimEntidades'[Entidad]
			RETURN
			IF(
			    CONTAINSSTRING(NombreEntidad, "Provincia de"),
			    SWITCH(
			        NombreEntidad,
			        "Provincia de Santa Fe", "Santa Fe",
			        "Provincia de Entre Ríos", "Entre Ríos",
			        "Provincia de San Juan", "San Juan",
			        "Provincia de Santa Cruz", "Santa Cruz",
			        NombreEntidad
			    ),
			    NombreEntidad
			)
		lineageTag: b91415ec-69e4-47bf-8668-86a83f6a8e9f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

