	partition Comercios_nuevos_2027 = m
		mode: import
		source =
				let
				    Origen = Sql.Database("ASJSQLDWLSTP", "ASJ_DW", [Query="#(tab)select dce.ComercioEcosistemaID#(lf)#(tab)#(tab)#(tab),dce.FechaAlta#(lf)#(tab)#(tab)#(tab),en.Entidad#(lf)#(tab)#(tab)#(tab),dce.Comercio#(lf)#(tab)#(tab)#(tab),DEN.NumeroEnte#(lf)#(tab)#(tab)#(tab),DEN.PersonaID#(lf)#(tab)#(tab)#(tab),dp.NumeroDocumento#(lf)#(lf)#(lf)FROM Operaciones.DimComercioEcosistemas DCE #(lf)#(tab)INNER JOIN Operaciones.DimEntes DEN ON DEN.EnteID = DCE.EnteID#(lf)#(tab)INNER JOIN Operaciones.DimEntidades EN ON EN.EntidadID = DEN.EntidadID#(lf)#(tab)left join PersonaUnica.DimPersonas dp on dp.PersonaID = den.PersonaID#(lf)#(tab)#(lf)#(tab)WHERE EN.EntidadDeComercio = 1#(lf)#(tab)and dce.FechaAlta >= '2025-07-01'#(lf)#(tab)#(tab)  AND NOT EXISTS (SELECT 1 FROM Operaciones.DimComerciosExclusiones CE #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)  WHERE DCE.ComercioEcosistemaID = CE.ComercioEcosistemaID)"])
				in
				    Origen

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

