		formatString: ddd dd/mm
		lineageTag: cb03ea43-0db5-4208-a872-3f646cecad52
		summarizeBy: none

		variation Variación
			isDefault
			relationship: 4da274a7-6da8-444b-9d70-ef953e41ead1
			defaultHierarchy: LocalDateTable_37d980f2-f6ad-4a65-b960-2139a49f0ba2.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	column EsUltimoMesCerrado =
			
			VAR FechaUltMesCerrado = EOMONTH ( TODAY() , -1 )
			VAR AnioMesUltMesCerrado = VALUE ( FORMAT ( FechaUltMesCerrado , "YYYYMM" ) )
			RETURN
			IF ( 'DimTiempo'[AñoMes] = AnioMesUltMesCerrado , 1 , 0 )
		lineageTag: 2227b83e-0097-4942-a70a-c240c49b58fb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column AñoMes = 'DimTiempo'[Año] * 100 + 'DimTiempo'[MesNumero]
		formatString: 0
		lineageTag: e66002be-3234-4d89-ab01-7c5e7f23ccf3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Es Mes Cerrado' =
			
			VAR AnioMesActual= YEAR (TODAY()) * 100 + MONTH (TODAY())
			RETURN IF (DimTiempo[AñoMes] < AnioMesActual , 1 , 0 )
		formatString: 0
		lineageTag: ba248e75-a0e1-4aa9-92a6-d1d224034852
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column HastaMesActual = ```
			
			IF(
			    'DimTiempo'[AñoMes] <= YEAR(TODAY()) * 100 + MONTH(TODAY()),
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: bb4a77f0-1a4c-451a-a06b-9d087ea72c31
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Mes Cerrado' = 'DimTiempo'[Fecha].[Date]<DATE(YEAR(TODAY()),MONTH(TODAY()),1)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 55b0a26d-e3ab-4c07-959a-4e6abfd38be7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FechaFuturo = 'DimTiempo'[Fecha].[Date]>TODAY()
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: d32310dd-2177-4a6a-9314-6d597c6cd737
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Indicador Año Fiscal' =
			
			-- 1. Identificamos el año en que inicia el año fiscal de la fila actual
			VAR FechaFila = DimTiempo[Fecha]
			VAR AnioFiscalFila = IF(MONTH(FechaFila) >= 7, YEAR(FechaFila), YEAR(FechaFila) - 1)
			
			-- 2. Identificamos el año en que inicia el año fiscal actual (basado en la fecha de hoy)
			VAR FechaHoy = TODAY()
			VAR AnioFiscalHoy = IF(MONTH(FechaHoy) >= 7, YEAR(FechaHoy), YEAR(FechaHoy) - 1)
			
			-- 3. Comparamos ambos años fiscales para asignar el código
			RETURN
			SWITCH(
			    AnioFiscalFila,
			    AnioFiscalHoy, 1,      -- Año fiscal actual
			    AnioFiscalHoy - 1, 2,  -- Año fiscal anterior
			    0                      -- Cualquier otro período
			)
		formatString: 0
		lineageTag: 6906c2dc-6f1b-416d-a6c2-497e47ebdbd0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

