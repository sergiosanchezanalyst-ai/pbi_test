	partition DimComercios_Unicos = calculated
		mode: import
		source = ```
				
				SUMMARIZE (
				    DimComercios,
				    DimComercios[ComercioID],
				    "Nombre Comercio", MAX ( DimComercios[Comercio] ),
				    "Numero Ente",     MAX ( DimComercios[NumeroEnte] ),
				    "Rubro",           MAX ( DimComercios[RubroComercio] ),
				    "Provincia",           MAX ( DimComercios[Provincia] ),
				    "Localidad",MAX ( DimComercios[Localidad_1] )
				)
				
				/*DimComercios_Unicos = 
				SUMMARIZE (
				    DimComercios,
				    DimComercios[IdComercio],
				    "Nombre Comercio", MAX ( DimComercios[NombreComercio] ),
				    "Numero Ente",     MAX ( DimComercios[NumeroEnte] )
				)*/
				```

