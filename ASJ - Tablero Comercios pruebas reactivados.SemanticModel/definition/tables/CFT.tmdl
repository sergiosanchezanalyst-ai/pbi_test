table CFT
	lineageTag: 8cafaf87-a879-4236-8db5-efa41bf05356

	measure 'Cantidad Sin Transacciones' =
			
			CALCULATE(
			    [Cantidad Comercios nuevos],
			    FILTER(
			        VALUES(DimComercios[ComercioID]), // Tu tabla de comercios y su columna ID
			        ISBLANK([TRX SIN FORMATO] || [TRX SIN FORMATO]= 0 // Tu medida base de transacciones
			    )
			))
		formatString: 0
		lineageTag: 1417b64a-81e7-43f0-a83f-fe1789c59eda

	measure 'Etiqueta Dinamica Reactivados todos acumulado' = ```
			
			VAR Anioseleccionado = SELECTEDVALUE('DimTiempo'[AñoFiscal])
			VAR ValorMensual = 
			    SWITCH(
			        TRUE(),
			        Anioseleccionado = 2026, [Comercios Reactivados 1],
			        Anioseleccionado = 2027, [Comercios Reactivados 2027],
			        ISBLANK(Anioseleccionado), [Comercios Reactivados 1] + [Comercios Reactivados 2027],
			        BLANK()
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    ValorMensual > 0, "+" & FORMAT(ValorMensual, "#,##0"),
			    ValorMensual < 0, FORMAT(ValorMensual, "#,##0"),
			    "0"
			)
			```
		lineageTag: 7132c474-5f41-4354-ae26-e6ae9c1e1e29

	measure 'Comercios nuevos 2027' = SUM(Comercios_nuevos_2027[trx])
		formatString: 0
		lineageTag: be30c90f-4759-46ff-a68c-740702908c2b

	measure 'Comercios sin Trx (Período Seleccionado)' =
			
			IF(
			    SELECTEDVALUE('DimTiempo'[AñoFiscal]) = 2027,
			    [Comercios nuevos sin transacciones FY 2027],
			    [Comercios Nuevos sin Trx]
			)
		formatString: 0
		lineageTag: b2a06cfa-41de-4581-9e43-c83529e0dddc

	measure test = "esta es una medida de prueba"
