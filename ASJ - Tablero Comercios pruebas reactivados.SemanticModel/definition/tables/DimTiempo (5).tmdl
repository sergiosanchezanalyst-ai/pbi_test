	column Periodo = FORMAT('DimTiempo (5)'[Fecha],"yyyy")&"/"&FORMAT('DimTiempo (5)'[Fecha],"mm")
		lineageTag: f4915a80-8505-425f-b9cd-23fbd29211a9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column HastaMesActual = ```
			
			IF(
			    'DimTiempo (5)'[AñoMes] <= YEAR(TODAY()) * 100 + MONTH(TODAY()),
			    1,
			    0
			)
			
			```
		lineageTag: 7f45fcd5-9b6c-4bcc-8964-98de18101f11
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column AñoMes = 'DimTiempo (5)'[Año] * 100 + 'DimTiempo (5)'[MesNumero]
		formatString: 0
		lineageTag: 29ab107c-3d52-4d21-8c80-c1f344916885
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Indicador Año Fiscal' =
			
			-- 1. Identificamos el año en que inicia el año fiscal de la fila actual
			VAR FechaFila = 'DimTiempo (5)'[Fecha]
			VAR AnioFiscalFila = IF(MONTH(FechaFila) >= 7, YEAR(FechaFila), YEAR(FechaFila) - 1)
			
			-- 2. Identificamos el año en que inicia el año fiscal actual (basado en la fecha de hoy)
			VAR FechaHoy = TODAY()
			VAR AnioFiscalHoy = IF(MONTH(FechaHoy) >= 7, YEAR(FechaHoy), YEAR(FechaHoy) - 1)
			
			-- 3. Comparamos ambos años fiscales para asignar el código
			RETURN
			SWITCH(
			    AnioFiscalFila,
			    AnioFiscalHoy, 1,      -- Año fiscal actual
			    AnioFiscalHoy - 1, 2,  -- Año fiscal anterior
			    0                      -- Cualquier otro período
			)
		formatString: 0
		lineageTag: e7ac5828-f3ec-460b-98c1-c0379731bbc7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

